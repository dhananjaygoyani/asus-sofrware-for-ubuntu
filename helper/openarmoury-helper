#!/usr/bin/python3 -I
"""Root helper for OpenArmoury. Started by pkexec once per session.

Reads one JSON request per line on stdin and answers one JSON line on stdout.
Self-contained on purpose: it runs as root, so it imports only the standard library
and trusts nothing it receives.
"""
import fcntl
import json
import os
import re
import stat
import struct
import sys
import time

MAX_LINE = 8192
MAX_REPORT = 1024
ASUS_VENDOR = "00000B05"
HANDSHAKE = b"ASUS Tech.Inc.\x00"
REPORT_IDS = (0x5A, 0x5D)
FAN_CURVE_HWMON = "asus_custom_fan_curve"
MAX_KEY_EVENTS = 512
MAX_KEY_DELAY_MS = 5000
MAX_KEYCODE = 248  # the keyboard range; buttons and firmware keys sit above it
EV_SYN, EV_KEY = 0, 1
UI_SET_EVBIT = 0x40045564
UI_SET_KEYBIT = 0x40045565
UI_DEV_SETUP = 0x405C5503
UI_DEV_CREATE = 0x5501
UI_DEV_DESTROY = 0x5502

NB_WMI_ATTRS = {
    "boot_sound": r"[01]",
    "dgpu_disable": r"[01]",
    "panel_od": r"[01]",
    "throttle_thermal_policy": r"[0-2]",
    "ppt_pl1_spl": r"\d{1,3}",
    "ppt_pl2_sppt": r"\d{1,3}",
}


class Refused(Exception):
    pass


def test_root():
    """A fake tree for tests and --demo. Never honoured when running as root."""
    if os.geteuid() == 0:
        return ""
    return os.environ.get("OPENARMOURY_TEST_ROOT", "")


def real(path):
    return test_root() + path


def read_text(path):
    with open(real(path), encoding="ascii", errors="replace") as f:
        return f.read().strip()


def check_armoury(attr, value):
    if not re.fullmatch(r"-?\d{1,9}|[A-Za-z0-9_-]{1,32}", value):
        raise Refused("bad attribute value")
    base = f"/sys/class/firmware-attributes/asus-armoury/attributes/{attr}"
    try:
        allowed = read_text(f"{base}/possible_values")
    except OSError:
        allowed = None
    if allowed is not None:
        if value not in allowed.split(";"):
            raise Refused("value not in possible_values")
        return
    try:
        low, high = int(read_text(f"{base}/min_value")), int(read_text(f"{base}/max_value"))
    except (OSError, ValueError):
        raise Refused("attribute limits unreadable") from None
    if not (re.fullmatch(r"-?\d{1,9}", value) and low <= int(value) <= high):
        raise Refused("value outside min/max")


def check_write(path, value):
    """Refuse unless (path, value) is one of the exact forms the app needs."""
    if not isinstance(path, str) or not isinstance(value, str) or len(path) > 200:
        raise Refused("bad request")

    if path == "/sys/firmware/acpi/platform_profile":
        if not re.fullmatch(r"[a-z][a-z-]{0,31}", value):
            raise Refused("bad profile")
        if value not in read_text("/sys/firmware/acpi/platform_profile_choices").split():
            raise Refused("profile not offered")
    elif m := re.fullmatch(
        r"/sys/class/firmware-attributes/asus-armoury/attributes/([a-z0-9_]{1,64})/current_value", path
    ):
        check_armoury(m[1], value)
    elif m := re.fullmatch(r"/sys/devices/platform/asus-nb-wmi/([a-z0-9_]{1,32})", path):
        if m[1] not in NB_WMI_ATTRS or not re.fullmatch(NB_WMI_ATTRS[m[1]], value):
            raise Refused("nb-wmi attribute or value refused")
    elif m := re.fullmatch(r"/sys/class/hwmon/(hwmon\d{1,3})/pwm([1-3])_(enable|auto_point[1-8]_(?:pwm|temp))", path):
        if read_text(f"/sys/class/hwmon/{m[1]}/name") != FAN_CURVE_HWMON:
            raise Refused("not the fan curve device")
        pattern = r"[123]" if m[3] == "enable" else r"\d{1,3}"
        if not re.fullmatch(pattern, value) or int(value) > 255:
            raise Refused("bad fan curve value")
    elif path == "/sys/class/leds/asus::kbd_backlight/brightness":
        if not re.fullmatch(r"[0-3]", value):
            raise Refused("bad brightness")
    elif path == "/sys/class/leds/asus::kbd_backlight/kbd_rgb_mode":
        if not re.fullmatch(r"[01] \d{1,2} \d{1,3} \d{1,3} \d{1,3} [0-2]", value):
            raise Refused("bad rgb mode")
        if any(int(v) > 255 for v in value.split()):
            raise Refused("bad rgb mode")
    elif path == "/sys/class/leds/asus::kbd_backlight/kbd_rgb_state":
        if not re.fullmatch(r"1 [01] [01] [01] [01]", value):
            raise Refused("bad rgb state")
    elif re.fullmatch(r"/sys/class/power_supply/BAT[A-Z0-9]{0,2}/charge_control_end_threshold", path):
        if not re.fullmatch(r"\d{2,3}", value) or not 20 <= int(value) <= 100:
            raise Refused("bad charge limit")
    else:
        raise Refused("path not allowed")

    # sysfs class paths are symlinks. Stop a path that resolves out of sysfs.
    sys_root = os.path.realpath(real("/sys"))
    resolved = os.path.realpath(real(path))
    if not resolved.startswith(sys_root + os.sep):
        raise Refused("path escapes /sys")


def do_write(path, value):
    check_write(path, value)
    target = real(path)
    if test_root():
        with open(target, "w", encoding="ascii") as f:
            f.write(value + "\n")
        return {}
    fd = os.open(target, os.O_WRONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        os.write(fd, value.encode("ascii"))
    finally:
        os.close(fd)
    return {}


def check_node(node):
    """The node must be a hidraw device with the ASUS vendor ID."""
    if not isinstance(node, str) or not re.fullmatch(r"hidraw\d{1,3}", node):
        raise Refused("bad hidraw node")
    uevent = read_text(f"/sys/class/hidraw/{node}/device/uevent")
    match = re.search(r"^HID_ID=[0-9A-Fa-f]{4}:([0-9A-Fa-f]{8}):", uevent, re.M)
    if not match or match[1].upper() != ASUS_VENDOR:
        raise Refused("not an ASUS device")
    return real(f"/dev/{node}")


def check_packet(data):
    """Only the packets documented as needed. Anything else, such as firmware commands, is refused."""
    if not 2 <= len(data) <= MAX_REPORT or data[0] not in REPORT_IDS:
        raise Refused("bad report")
    opcode = data[1]
    body = data[1:]
    if opcode == 0x41:
        if not body.rstrip(b"\x00") + b"\x00" == HANDSHAKE:
            raise Refused("bad handshake")
    elif opcode == 0x05:
        if body[1:4] != b"\x20\x31\x00" or body[4] not in (0x08, 0x10, 0x1A) or any(body[5:]):
            raise Refused("bad query")
    elif opcode == 0xBA:
        if body[1:3] != b"\xc5\xc4" or body[3] > 3 or any(body[4:]):
            raise Refused("bad brightness packet")
    elif opcode == 0xBD:
        # Power states: a fixed sub-command and four bytes of flags, nothing after them.
        if data[0] != 0x5D or body[1] != 0x01 or any(body[6:]):
            raise Refused("bad power state packet")
    elif opcode not in (0xB3, 0xB4, 0xB5, 0xBC) or data[0] != 0x5D:
        raise Refused("opcode not allowed")


def hidraw_ioc(direction, nr, size):
    return (direction << 30) | (size << 16) | (ord("H") << 8) | nr


def open_node(path):
    fd = os.open(path, os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC)
    if not stat.S_ISCHR(os.fstat(fd).st_mode):
        os.close(fd)
        raise Refused("not a device node")
    return fd


def do_hid(node, kind, data_hex):
    path = check_node(node)
    if not isinstance(data_hex, str) or not re.fullmatch(r"(?:[0-9a-f]{2})+", data_hex):
        raise Refused("bad data")
    data = bytes.fromhex(data_hex)
    check_packet(data)
    if kind not in ("output", "feature"):
        raise Refused("bad kind")
    if test_root():
        with open(path, "a", encoding="ascii") as f:
            f.write(f"{kind} {data_hex}\n")
        return {}
    fd = open_node(path)
    try:
        if kind == "output":
            os.write(fd, data)
        else:
            fcntl.ioctl(fd, hidraw_ioc(3, 0x06, len(data)), bytearray(data))
    finally:
        os.close(fd)
    return {}


def do_get_feature(node, report_id, length):
    path = check_node(node)
    if report_id not in REPORT_IDS or not isinstance(length, int) or not 2 <= length <= MAX_REPORT:
        raise Refused("bad feature read")
    if test_root():
        try:
            with open(path + ".feature", encoding="ascii") as f:
                return {"data": f.read().strip()}
        except OSError:
            return {"data": bytes([report_id] + [0] * (length - 1)).hex()}
    fd = open_node(path)
    try:
        buf = bytearray(length)
        buf[0] = report_id
        fcntl.ioctl(fd, hidraw_ioc(3, 0x07, length), buf)
        return {"data": bytes(buf).hex()}
    finally:
        os.close(fd)


def check_key_events(events):
    """Macro playback: keyboard keys only, bounded in length and time."""
    if not isinstance(events, list) or not 1 <= len(events) <= MAX_KEY_EVENTS:
        raise Refused("bad macro length")
    total = 0
    for event in events:
        if not (isinstance(event, list) and len(event) == 3 and all(type(v) is int for v in event)):
            raise Refused("bad macro event")
        code, value, delay = event
        if not 1 <= code <= MAX_KEYCODE or value not in (0, 1) or not 0 <= delay <= MAX_KEY_DELAY_MS:
            raise Refused("bad macro event")
        total += delay
    if total > 60000:
        raise Refused("macro too long")


def do_keys(events):
    check_key_events(events)
    if test_root():
        with open(real("/dev/uinput"), "a", encoding="ascii") as f:
            f.write(json.dumps(events) + "\n")
        return {}
    fd = open_node("/dev/uinput")
    created = False
    held = set()

    def emit(kind, code, value):
        os.write(fd, struct.pack("@qqHHi", 0, 0, kind, code, value))

    try:
        fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
        for code in {event[0] for event in events}:
            fcntl.ioctl(fd, UI_SET_KEYBIT, code)
        setup = struct.pack("@HHHH80sI", 3, 0x0B05, 0x7E57, 1, b"OpenArmoury macro", 0)
        fcntl.ioctl(fd, UI_DEV_SETUP, setup)
        fcntl.ioctl(fd, UI_DEV_CREATE)
        created = True
        time.sleep(0.2)  # let the desktop notice the new device
        for code, value, delay in events:
            time.sleep(delay / 1000)
            emit(EV_KEY, code, value)
            emit(EV_SYN, 0, 0)
            (held.add if value else held.discard)(code)
    finally:
        if created:
            # Never leave a key stuck down, even if something failed part way.
            for code in held:
                emit(EV_KEY, code, 0)
            emit(EV_SYN, 0, 0)
            time.sleep(0.05)
            fcntl.ioctl(fd, UI_DEV_DESTROY)
        os.close(fd)
    return {}


def handle(request):
    if not isinstance(request, dict):
        raise Refused("bad request")
    op = request.get("op")
    if op == "ping":
        return {}
    if op == "write":
        return do_write(request.get("path"), request.get("value"))
    if op == "hid":
        return do_hid(request.get("node"), request.get("kind"), request.get("data"))
    if op == "get_feature":
        return do_get_feature(request.get("node"), request.get("report_id"), request.get("length"))
    if op == "keys":
        return do_keys(request.get("events"))
    raise Refused("unknown op")


def main():
    for line in sys.stdin:
        try:
            if len(line) > MAX_LINE:
                raise Refused("request too long")
            reply = {"ok": True, **handle(json.loads(line))}
        except (Refused, OSError, ValueError, KeyError, TypeError, IndexError) as err:
            reply = {"ok": False, "error": str(err)}
        print(json.dumps(reply), flush=True)


if __name__ == "__main__":
    main()
